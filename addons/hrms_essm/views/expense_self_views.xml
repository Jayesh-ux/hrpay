<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_essm_my_expenses" model="ir.actions.act_window">
        <field name="name">My Expenses</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_essm_team_expense_approve" model="ir.actions.act_window">
        <field name="name">Expenses to Approve</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
    </record>

</odoo>
