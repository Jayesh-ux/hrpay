<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hrms_employee_document_list" model="ir.ui.view">
        <field name="name">hrms.employee.document.list</field>
        <field name="model">hrms.employee.document</field>
        <field name="arch" type="xml">
            <list string="My documents" create="false" delete="false">
                <field name="name"/>
                <field name="doc_type"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_hrms_employee_document_form" model="ir.ui.view">
        <field name="name">hrms.employee.document.form</field>
        <field name="model">hrms.employee.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="doc_type"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="File">
                        <field name="file_name" invisible="1"/>
                        <field name="file" filename="file_name" widget="binary"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_essm_my_documents" model="ir.actions.act_window">
        <field name="name">My Documents</field>
        <field name="res_model">hrms.employee.document</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
