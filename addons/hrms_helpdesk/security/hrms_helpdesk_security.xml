<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_hrms_helpdesk_agent" model="res.groups">
            <field name="name">HR Service Desk Agent</field>
            <field name="category_id" ref="helpdesk_mgmt.module_helpdesk_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">May work any ticket. Confidential cases remain restricted to the assigned team even for agents.</field>
        </record>

        <record id="group_hrms_confidential_case_handler" model="res.groups">
            <field name="name">Confidential Case Handler</field>
            <field name="category_id" ref="helpdesk_mgmt.module_helpdesk_category"/>
            <field name="implied_ids" eval="[(4, ref('group_hrms_helpdesk_agent'))]"/>
            <field name="comment">Additional clearance for grievances, POSH and disciplinary cases. Required because those records expose the complainant.</field>
        </record>

        <!-- Confidential cases: assigned team only, and the confidential
             clearance group can see them across teams. Deliberately excludes
             hrms_confidential from the Auditor group, because an auditor who
             can read an unredacted POSH complaint is itself a data incident. -->
        <record id="rule_helpdesk_ticket_confidential" model="ir.rule">
            <field name="name">Confidential tickets: assigned team or cleared handler</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="domain_force">['|', ('hrms_confidential', '=', False), ('user_id', '=', user.id), ('team_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_hrms_helpdesk_agent'))]"/>
        </record>

        <record id="rule_helpdesk_ticket_confidential_handler" model="ir.rule">
            <field name="name">Confidential tickets: cleared handler sees all</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="domain_force">['|', ('hrms_confidential', '=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hrms_confidential_case_handler'))]"/>
        </record>

        <!-- Statutory deadlines on a ticket are part of the compliance record,
             so an agent cannot shorten or erase them. -->
        <record id="rule_helpdesk_ticket_deadline_immutable" model="ir.rule">
            <field name="name">Statutory ticket deadlines: agents cannot change</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="domain_force">['|', ('hrms_statutory_deadline', '=', False), ('hrms_deadline_locked_by', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_hrms_helpdesk_agent'))]"/>
        </record>

    </data>
</odoo>
