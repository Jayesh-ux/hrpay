<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Core extension UI: payroll period locks, the append-only audit log, the
      integration sync log, and the HR-security section of the employee form.

      Menus are group-gated to match the model ACLs. Content that only the
      payroll admin may write is still shown read-only to auditors, mirroring the
      access rules rather than widening them.
    -->

    <record id="view_payroll_period_lock_list" model="ir.ui.view">
        <field name="name">payroll.period.lock.list</field>
        <field name="model">payroll.period.lock</field>
        <field name="arch" type="xml">
            <list string="Payroll period locks"
                  decoration-success="state == 'released'"
                  decoration-warning="state == 'review'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'review'"
                       decoration-success="state == 'released'"/>
                <field name="locked_by_id"/>
                <field name="released_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_period_lock_form" model="ir.ui.view">
        <field name="name">payroll.period.lock.form</field>
        <field name="model">payroll.period.lock</field>
        <field name="arch" type="xml">
            <form string="Payroll period lock">
                <header>
                    <button name="action_start_review" string="Start review"
                            type="object" invisible="state != 'draft'"/>
                    <button name="action_lock" string="Lock period"
                            type="object" class="btn-primary"
                            invisible="state != 'review'"/>
                    <button name="action_release" string="Release"
                            type="object" class="btn-primary"
                            invisible="state != 'locked'"/>
                    <button name="action_reopen" string="Reopen"
                            type="object" invisible="state != 'locked'"
                            groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,locked,released"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="not locked_by_id or state != 'locked'">
                        Locked by <field name="locked_by_id" class="oe_inline"/>.
                        A different user must release it (segregation of duties).
                    </div>
                    <group>
                        <group string="Period">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Integrity">
                            <field name="checksum"/>
                            <field name="ai_flags_count"/>
                            <field name="ai_flags_acknowledged"/>
                        </group>
                    </group>
                    <group string="Attribution">
                        <group>
                            <field name="locked_by_id" readonly="1"/>
                            <field name="locked_at"/>
                        </group>
                        <group>
                            <field name="released_by_id"/>
                            <field name="released_at"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="lock_note"
                               placeholder="Reason for locking / reopening an anomaly"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payroll_period_lock_search" model="ir.ui.view">
        <field name="name">payroll.period.lock.search</field>
        <field name="model">payroll.period.lock</field>
        <field name="arch" type="xml">
            <search string="Payroll period locks">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="date_from"/>
                <filter name="filter_locked" string="Locked" domain="[('state', '=', 'locked')]"/>
                <filter name="filter_released" string="Released" domain="[('state', '=', 'released')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payroll_period_lock" model="ir.actions.act_window">
        <field name="name">Payroll Period Locks</field>
        <field name="res_model">payroll.period.lock</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_payroll_period_lock_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payroll periods</p>
            <p>Open a period to gate retroactive payroll changes. A locked period
               must be corrected with an off-cycle adjustment, never by editing the
               original inputs.</p>
        </field>
    </record>

    <record id="view_hrms_audit_log_list" model="ir.ui.view">
        <field name="name">hrms.audit.log.list</field>
        <field name="model">hrms.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit log" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="user_id"/>
                <field name="action" widget="badge"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="note" optional="show"/>
                <field name="changes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hrms_audit_log_form" model="ir.ui.view">
        <field name="name">hrms.audit.log.form</field>
        <field name="model">hrms.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit entry" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Event">
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="action"/>
                        </group>
                        <group string="Subject">
                            <field name="model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Detail">
                        <field name="changes"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hrms_audit_log_search" model="ir.ui.view">
        <field name="name">hrms.audit.log.search</field>
        <field name="model">hrms.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit log">
                <field name="model"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="res_id"/>
                <field name="name"/>
                <filter name="filter_sensitive" string="Sensitive reads"
                        domain="[('action', '=', 'read_sensitive')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model'}"/>
                    <filter name="group_action" string="Action"
                            context="{'group_by': 'action'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hrms_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">hrms.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hrms_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No audit entries</p>
            <p>Every sensitive read, lock, release and override is recorded here.
               The log is append-only: entries cannot be edited or deleted.</p>
        </field>
    </record>

    <record id="view_integration_sync_log_list" model="ir.ui.view">
        <field name="name">integration.sync.log.list</field>
        <field name="model">integration.sync.log</field>
        <field name="arch" type="xml">
            <list string="Integration sync log"
                  decoration-danger="state in ('failed', 'dead_letter')"
                  decoration-muted="state in ('success', 'duplicate')">
                <field name="name"/>
                <field name="direction" widget="badge"
                       decoration-info="direction == 'inbound'"/>
                <field name="entity"/>
                <field name="operation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state in ('failed', 'dead_letter')"/>
                <field name="external_id"/>
                <field name="http_status"/>
                <field name="attempts"/>
                <field name="next_retry_at"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="view_integration_sync_log_form" model="ir.ui.view">
        <field name="name">integration.sync.log.form</field>
        <field name="model">integration.sync.log</field>
        <field name="arch" type="xml">
            <form string="Integration sync log" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Call">
                            <field name="name"/>
                            <field name="direction"/>
                            <field name="entity"/>
                            <field name="entity_id"/>
                            <field name="operation"/>
                            <field name="external_id"/>
                        </group>
                        <group string="Result">
                            <field name="state"/>
                            <field name="http_status"/>
                            <field name="attempts"/>
                            <field name="error_class"/>
                            <field name="next_retry_at"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Diagnostics">
                        <field name="idempotency_key"/>
                        <field name="payload_hash"/>
                        <field name="request_id"/>
                        <field name="created_at"/>
                        <field name="completed_at"/>
                        <field name="last_error"/>
                        <field name="payload_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_integration_sync_log_search" model="ir.ui.view">
        <field name="name">integration.sync.log.search</field>
        <field name="model">integration.sync.log</field>
        <field name="arch" type="xml">
            <search string="Integration sync log">
                <field name="name"/>
                <field name="entity"/>
                <field name="external_id"/>
                <field name="idempotency_key"/>
                <field name="state"/>
                <field name="direction"/>
                <filter name="filter_failed" string="Failed"
                        domain="[('state', 'in', ('failed', 'dead_letter'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_entity" string="Entity"
                            context="{'group_by': 'entity'}"/>
                    <filter name="group_direction" string="Direction"
                            context="{'group_by': 'direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_integration_sync_log" model="ir.actions.act_window">
        <field name="name">Integration Sync Log</field>
        <field name="res_model">integration.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_integration_sync_log_search"/>
    </record>

    <record id="view_hr_employee_form_hrms_security" model="ir.ui.view">
        <field name="name">hr.employee.form.hrms.security</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='hr_settings']" position="after">
                <page string="HR Security" name="hrms_security" groups="hr.group_hr_user">
                    <group string="Integration sync">
                        <group>
                            <field name="payroll_external_id"/>
                            <field name="sync_status"/>
                            <field name="sync_hash" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_synced_at"/>
                            <field name="last_sync_error"/>
                        </group>
                    </group>
                    <group string="Engagement and statutory">
                        <group>
                            <field name="contract_type"/>
                            <field name="hrms_tax_regime"/>
                            <field name="join_date"/>
                            <field name="hrms_service_start"/>
                            <field name="hrms_previous_employer_service_months"/>
                            <field name="hrms_separation_state"/>
                        </group>
                        <group>
                            <field name="hrms_establishment_id"/>
                            <field name="hrms_state_code"/>
                            <field name="hrms_contract_start"/>
                            <field name="hrms_contract_end"/>
                        </group>
                    </group>
                    <group string="Confidential identifiers" colspan="2">
                        <div class="o_row" colspan="2">
                            <label for="pan_number_display" string="PAN"/>
                            <field name="pan_number_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'pan_number'}"
                                    groups="hr.group_hr_user"/>
                        </div>
                        <div class="o_row" colspan="2">
                            <label for="aadhaar_number_display" string="Aadhaar"/>
                            <field name="aadhaar_number_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'aadhaar_number'}"
                                    groups="hr.group_hr_manager"/>
                        </div>
                        <div class="o_row" colspan="2">
                            <label for="bank_account_number_display" string="Bank account"/>
                            <field name="bank_account_number_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'bank_account_number'}"/>
                        </div>
                        <div class="o_row" colspan="2">
                            <label for="bank_ifsc_display" string="Bank IFSC"/>
                            <field name="bank_ifsc_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'bank_ifsc'}"/>
                        </div>
                        <div class="o_row" colspan="2">
                            <label for="epf_number_display" string="EPF/UAN"/>
                            <field name="epf_number_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'epf_number'}"
                                    groups="hr.group_hr_user"/>
                        </div>
                        <div class="o_row" colspan="2">
                            <label for="esic_number_display" string="ESIC IP"/>
                            <field name="esic_number_display" readonly="1"/>
                            <button name="action_reveal_secret" type="object"
                                    class="btn-link" string="Reveal" icon="fa-eye"
                                    context="{'hrms_reveal_field': 'esic_number'}"
                                    groups="hr.group_hr_user"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_hrms_core_ext_root"
              name="Compliance"
              parent="hr.menu_hr_root"
              sequence="95"
              groups="hrms_core_ext.group_hrms_payroll_admin,hrms_core_ext.group_hrms_auditor"/>

    <menuitem id="menu_payroll_period_lock"
              name="Payroll Period Locks"
              parent="menu_hrms_core_ext_root"
              action="action_payroll_period_lock"
              sequence="10"
              groups="hrms_core_ext.group_hrms_payroll_admin,hrms_core_ext.group_hrms_auditor"/>

    <menuitem id="menu_hrms_audit_log"
              name="Audit Log"
              parent="menu_hrms_core_ext_root"
              action="action_hrms_audit_log"
              sequence="20"
              groups="hrms_core_ext.group_hrms_auditor"/>

    <menuitem id="menu_integration_sync_log"
              name="Integration Sync Log"
              parent="menu_hrms_core_ext_root"
              action="action_integration_sync_log"
              sequence="30"
              groups="hrms_core_ext.group_hrms_payroll_admin"/>

</odoo>
