<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_hrms_payroll" model="ir.module.category">
            <field name="name">HR Payroll</field>
            <field name="parent_id" ref="base.module_category_human_resources"/>
            <field name="sequence">25</field>
        </record>


        <!-- ── Groups ─────────────────────────────────────────────────── -->
        <record id="group_hrms_payroll_admin" model="res.groups">
            <field name="name">Payroll Admin</field>
            <field name="category_id" ref="module_category_hrms_payroll"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hrms_finance_approver" model="res.groups">
            <field name="name">Finance Approver</field>
            <field name="category_id" ref="module_category_hrms_payroll"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_hrms_roster_manager" model="res.groups">
            <field name="name">Roster Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <record id="group_hrms_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Read-only across payroll, F&amp;F, expenses and audit logs. No write access anywhere.</field>
        </record>

        <!-- Statutory configuration is deliberately separated from
             HR Admin: the person who administers HR must not be the person who
             signs off a statutory rate. -->
        <record id="group_hrms_statutory_admin" model="res.groups">
            <field name="name">Statutory Config Admin</field>
            <field name="category_id" ref="module_category_hrms_payroll"/>
            <field name="implied_ids" eval="[(4, ref('hrms_core_ext.group_hrms_payroll_admin'))]"/>
            <field name="comment">Creates and edits draft statutory rules. Cannot self-validate.</field>
        </record>

        <record id="group_hrms_statutory_validator" model="res.groups">
            <field name="name">Statutory Validator</field>
            <field name="category_id" ref="module_category_hrms_payroll"/>
            <field name="comment">Signs off statutory rule versions. Must be held by a qualified payroll or tax professional. Cannot be the same user who authored the version.</field>
        </record>

        <record id="group_hrms_ai_service" model="res.groups">
            <field name="name">AI Service (read-only payroll)</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Machine identity for the AI layer. Read-only on payroll by construction.</field>
        </record>

        <!-- ── Record rules ────────────────────────────────────────────── -->

        <!-- Aadhaar/PAN columns additionally gated at column level in the model
             definition (groups= on the *_enc fields). -->


        <!-- The rule restricting negative final settlements lives in
             hrms_fnf/security/hrms_fnf_security.xml: hrms_core_ext is loaded
             first, so a reference to hrms_fnf.model_hrms_fnf_case here would
             resolve to nothing at install time. -->

    </data>
</odoo>
