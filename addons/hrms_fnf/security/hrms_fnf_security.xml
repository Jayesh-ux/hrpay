<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A settlement amount is money leaving the business, so approval is
             separated from preparation. HR prepares and acknowledges; Finance
             approves; payment needs a second person. -->
        <record id="rule_fnf_case_prepare" model="ir.rule">
            <field name="name">F&amp;F: payroll may prepare, finance approves</field>
            <field name="model_id" ref="hrms_fnf.model_hrms_fnf_case"/>
            <field name="domain_force">[('separation_state', 'in', ('draft', 'under_calculation', 'calculated', 'disputed'))]</field>
            <field name="groups" eval="[(4, ref('hrms_core_ext.group_hrms_payroll_admin'))]"/>
        </record>

        <record id="rule_fnf_case_own_employee" model="ir.rule">
            <field name="name">F&amp;F: employee sees only their own case</field>
            <field name="model_id" ref="hrms_fnf.model_hrms_fnf_case"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Negative settlements are restricted at the record-rule level, not
             just the UI: an amount owed by an employee is sensitive and a
             negative balance is the state most likely to be quietly absorbed. -->
        <record id="rule_fnf_case_negative" model="ir.rule">
            <field name="name">F&amp;F: negative settlements visible to finance and HR only</field>
            <field name="model_id" ref="hrms_fnf.model_hrms_fnf_case"/>
            <field name="domain_force">['|', ('is_negative_settlement', '=', False), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
