<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Payroll data: hidden from ordinary employees entirely. Lives here
             rather than in hrms_core_ext because the payslip model comes from
             OCA hr_payroll_community, which core_ext does not depend on. -->
        <record id="rule_hr_employee_payslip_own" model="ir.rule">
            <field name="name">Employee: read own payslips only</field>
            <field name="model_id" ref="hr_payroll_community.model_hr_payslip"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'in', [e for e in user.employee_ids.ids])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
