__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.env
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
node_modules/
*.log
tmp/
private/

# ─── New dev stack (docker-compose.yml) ─────────────────────────────────────
# The compose file mounts .oca read-only; it is fetched, never committed, and
# pinned by SHA in versions/lock.txt instead.
.oca/
# Test-run logs and reports are evidence and ARE committed on purpose. The
# blanket *.log rule above would otherwise exclude the log each report cites.
!docs/test-runs/*.log
!docs/test-runs/*.md
