# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env. NEVER commit the real .env.
# Secrets are injected by Vault in production; these are dev placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Odoo ───────────────────────────────────────────────────────────────────
ODOO_VERSION=18.0
ODOO_PYTHON=3.12
POSTGRESQL_VERSION=16
ODOO_DB=hrpay
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-dev-only
ODOO_ADMIN_PASSWORD=change-me-dev-only
ODOO_ADDONS_PATH=/opt/addons,/mnt/oca-addons,/mnt/odoo/addons

# ─── Keycloak (OIDC) ────────────────────────────────────────────────────────
KEYCLOAK_VERSION=26.0
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-dev-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only
KEYCLOAK_REALM=hrpay
KEYCLOAK_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=hrpay-api
OIDC_CLIENT_SECRET=change-me-dev-only
OIDC_HRMS_CLIENT_ID=hrpay-odoo
OIDC_HRMS_CLIENT_SECRET=change-me-dev-only

# ─── Vault ──────────────────────────────────────────────────────────────────
VAULT_VERSION=1.17
VAULT_DEV_ROOT_TOKEN=change-me-dev-only

# ─── Integration service ────────────────────────────────────────────────────
INTEGRATION_DB=integration
INTEGRATION_DB_USER=integration
INTEGRATION_DB_PASSWORD=change-me-dev-only
RABBITMQ_DEFAULT_USER=hrms
RABBITMQ_DEFAULT_PASS=change-me-dev-only
REDIS_PASSWORD=change-me-dev-only

# ─── Webhook HMAC (rotate per environment; 32+ bytes, base64 or hex) ─────────
WEBHOOK_HMAC_SECRET=change-me-32-bytes-minimum-rotate-me
WEBHOOK_HMAC_SECRET_PREVIOUS=   # for graceful rotation
WEBHOOK_TOLERANCE_SECONDS=300

# ─── Column-level encryption for bank/PAN/Aadhaar ───────────────────────────
# 32-byte key, base64-encoded. Rotate via key version in Vault.
# Generate: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_KEY_VERSION=1

# ─── AI service ─────────────────────────────────────────────────────────────
AI_DB=ai
AI_DB_USER=ai
AI_DB_PASSWORD=change-me-dev-only
AI_MODEL_ROUTER_BASE_URL=http://llm-router:8080/v1
AI_MODEL_ROUTER_API_KEY=change-me-dev-only
AI_MODEL_DEFAULT=open-source-default
AI_FREE_TOKEN_QUOTA=1000000
AI_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_OCR_ENGINE=paddleocr
AI_ALLOW_PAYROLL_WRITES=false     # hard constraint: payroll is read-only to AI

# ─── Roster solver ──────────────────────────────────────────────────────────
SOLVER_MAX_WORKERS=8
SOLVER_DEFAULT_TIME_LIMIT_SECONDS=120
SOLVER_DEFAULT_SEED=42

# ─── Observability ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me-dev-only
METRICS_RETENTION=30d
