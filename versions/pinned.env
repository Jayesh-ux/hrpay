# Verified version manifest — 2026-10-05
#
# ⚠️ PROPOSED, pending Phase 0 sign-off (see docs/phase0/go-no-go.md §7).
# ⚠️ Anything marked EXCLUDED must never be installed: it is Odoo Enterprise (OPL-1)
#    and violates the project's no-Enterprise-code rule.
#
# Verification method for every OCA/Open HRMS entry: raw __manifest__.py read at the
# pinned git branch on 2026-10-05. See go-no-go.md Appendix.

# ─── Core platform ───────────────────────────────────────────────────────────
ODOO_VERSION=18.0
ODOO_PYTHON=3.12                  # Odoo 18 declares >=3.10 but is tested on 3.10-3.12
POSTGRESQL_VERSION=16

# ─── Odoo Community addons we rely on (present in odoo/odoo@18.0) ────────────
ODOO_CE_MODULES=hr,hr_attendance,hr_expense,hr_holidays,hr_contract,hr_recruitment,hr_skills,hr_timesheet,survey,resource,product,account,l10n_in

# ─── Odoo Enterprise addons — ABSENT from Community. DO NOT INSTALL. ─────────
ODOO_EE_ABSENT=planning,hr_payroll,hr_appraisal,account_accountant,l10n_in_hr_payroll,documents,sign,studio,knowledge
# Impact:
#   planning             -> Phase 3D builds custom hr_roster + OR-Tools solver
#   hr_payroll           -> replaced by hr_payroll_community (LGPL-3)
#   hr_appraisal         -> replaced by oh_appraisal (AGPL-3)
#   account_accountant   -> see go-no-go.md Decision D3
#   l10n_in_hr_payroll   -> no CE shortcut for India payroll; all statutory logic is bespoke

# ─── Open HRMS (github.com/CybroOdoo/OpenHRMS, branch 18.0) ──────────────────
# LGPL-3 unless noted. All verified Community-compatible.
OPENHRMS_REPO=https://github.com/CybroOdoo/OpenHRMS
OPENHRMS_BRANCH=18.0
OPENHRMS_REPO_LAST_COMMIT=2026-08-19   # ⚠️ 18.0 branch last commit is "Initial Commit" — see Gate 1A
OH_MODULE_hr_payroll_community=18.0.1.0.0        # LGPL-3  deps: hr_contract, hr_holidays
OH_MODULE_hr_payroll_account_community=18.0.1.0.0 # LGPL-3  deps: hr_payroll_community, account
OH_MODULE_hr_resignation=18.0.1.0.0               # LGPL-3  deps: hr_employee_updation
OH_MODULE_ohrms_loan_accounting=18.0.1.0.0        # LGPL-3
OH_MODULE_hr_employee_shift=18.0.1.0.0            # LGPL-3  deps: hr_payroll_community, resource
OH_MODULE_oh_appraisal=18.0.1.0.0                 # AGPL-3  deps: hr, survey
OH_MODULE_ohrms_core=18.0.x                       # LGPL-3

# Open HRMS Enterprise variants — OPL-1, Odoo Enterprise ONLY. EXCLUDED.
OH_EE_EXCLUDED=ent_hrms_core,ent_hrms_dashboard,ent_hr_employee_shift,ent_hrms_payroll,ent_hr_payroll_extension,ent_hrms_appraisal,ent_hrms_goals

# ─── OCA helpdesk (github.com/OCA/helpdesk, branch 18.0) ────────────────────
OCA_HELPDESK_REPO=https://github.com/OCA/helpdesk
OCA_HELPDESK_BRANCH=18.0
OCA_HELPDESK_LAST_COMMIT=2026-10-01
OCA_MODULE_helpdesk_mgmt=18.0.1.18.0             # AGPL-3
OCA_MODULE_helpdesk_mgmt_sla=18.0.2.1.0          # AGPL-3  deps: base, helpdesk_mgmt, resource  <- business hours
OCA_MODULE_helpdesk_type=18.0.1.2.1              # AGPL-3
OCA_MODULE_helpdesk_type_sla=18.0.1.0.0          # AGPL-3  SLA per ticket type
OCA_MODULE_helpdesk_mgmt_rating=18.0.1.0.2        # AGPL-3  CSAT
OCA_MODULE_helpdesk_portal_restriction=18.0.1.1.0 # AGPL-3
OCA_MODULE_helpdesk_mgmt_merge=18.0.1.0.2         # AGPL-3

# ─── OCA hr / server-tools (18.0, active) ───────────────────────────────────
OCA_HR_REPO=https://github.com/OCA/hr
OCA_HR_BRANCH=18.0
OCA_HR_LAST_COMMIT=2026-10-01
OCA_SERVER_TOOLS_BRANCH=18.0                      # last commit 2026-09-30

# ─── OCA India localization — UNAVAILABLE ────────────────────────────────────
# github.com/OCA/l10n-india: 18.0 branch contains ZERO addons.
# Branch audit: 14.0=1 addon, 15.0/16.0/17.0/18.0/19.0=0 addons. Last commit 2025-02-02.
# => India statutory HR/payroll logic is entirely bespoke.
# India accounting/GST comes from Odoo core addons/l10n_in (Community, present).
OCA_L10N_INDIA_STATUS=unavailable
INDIA_ACCOUNTING_SOURCE=odoo_core:addons/l10n_in

# ─── REJECTED: TimeTrex ──────────────────────────────────────────────────────
# No-go on three independent grounds (go-no-go.md §3.1):
#   1. Community Edition sunset. portal.timetrex.com/download.php -> HTTP 403 -> request-demo
#      redirect. github.com/timetrex/timetrex is a 2018 stub (10 stars, README only).
#      => cannot version-pin, vendor or patch. Not buildable.
#   2. Tax engine is US/Canada only (US-Medicare, US-SS, US-FUTA, US Federal/State/Local
#      income tax, Canada CPP/CPP2/EI). No PF, ESI, PT, TDS, Form 16, 24Q, ECR.
#   3. CE removed LDAP/SSO -> Keycloak OIDC impossible.
TIMETREX_STATUS=rejected
TIMETREX_REPLACED_BY=hr_payroll_community

# ─── Services (versions to be pinned at Gate 1B) ─────────────────────────────
# Intentionally unpinned pending Gate 1A outcome, since the payroll engine choice
# determines the integration service topology.
#   integration-service : FastAPI + RabbitMQ + Redis
#   roster-solver       : Python + OR-Tools CP-SAT
#   ai-service          : open-source model router + RAG + PaddleOCR/docTR
#   keycloak, vault, nginx, prometheus, grafana